# This repository does not hold private database credentials.
#
# Public web/API containers must set OPENVALLEY_RUNTIME=public and must never
# receive OPENVALLEY_PRIVATE_DATABASE_URL.
OPENVALLEY_RUNTIME=operator

# This server-only address is for the public web service in Compose. It is not
# a browser-visible setting and must not use a NEXT_PUBLIC_ variable.
# INTERNAL_BASELINE_API_URL=http://api:8998

# Operator-only secret, supplied by protected secret management; do not put a
# connection string here, in Compose files, in CI variables, or in logs.
# OPENVALLEY_PRIVATE_DATABASE_URL=
