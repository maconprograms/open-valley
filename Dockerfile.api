# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:0.6-python3.12-bookworm-slim AS build

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# The Dockerfile deliberately avoids COPY . . so raw worktree material can
# never enter an image layer. The release reader has exactly its code and the
# explicitly promoted public artifacts.
COPY src ./src
COPY releases ./releases
RUN uv sync --frozen --no-dev --no-install-project

FROM python:3.12-slim

WORKDIR /app
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH=/app \
    OPENVALLEY_RUNTIME=public \
    PYTHONDONTWRITEBYTECODE=1

RUN groupadd --system openvalley && useradd --system --gid openvalley openvalley
COPY --from=build --chown=openvalley:openvalley /app/.venv /app/.venv
COPY --from=build --chown=openvalley:openvalley /app/src /app/src
COPY --from=build --chown=openvalley:openvalley /app/releases /app/releases

USER openvalley
EXPOSE 8998
CMD ["uvicorn", "src.warren_baseline.app:app", "--host", "0.0.0.0", "--port", "8998"]
