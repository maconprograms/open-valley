# syntax=docker/dockerfile:1

FROM node:22-alpine AS build

WORKDIR /app/web
ARG INTERNAL_BASELINE_API_URL=http://api:8998
ENV INTERNAL_BASELINE_API_URL=${INTERNAL_BASELINE_API_URL}

COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine

WORKDIR /app/web
ENV NODE_ENV=production \
    INTERNAL_BASELINE_API_URL=http://api:8998

COPY --from=build --chown=node:node /app/web/package.json ./
COPY --from=build --chown=node:node /app/web/package-lock.json ./
COPY --from=build --chown=node:node /app/web/next.config.ts ./
COPY --from=build --chown=node:node /app/web/node_modules ./node_modules
COPY --from=build --chown=node:node /app/web/.next ./.next
COPY --from=build --chown=node:node /app/web/public ./public

USER node
EXPOSE 3000
CMD ["npm", "run", "start", "--", "-p", "3000"]
